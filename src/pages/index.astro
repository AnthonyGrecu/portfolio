---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Anthony Grecu — CS student at Queen's University and EPM Solution Analyst at Metrolinx." />
    <title>Anthony Grecu</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://grecua.com" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://grecua.com" />
    <meta property="og:title" content="Anthony Grecu" />
    <meta property="og:description" content="Computer Science student at Queen's University. EPM Solution Analyst at Metrolinx. Building thoughtful software." />
    <meta property="og:image" content="https://grecua.com/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Anthony Grecu" />
    <meta name="twitter:description" content="Computer Science student at Queen's University. EPM Solution Analyst at Metrolinx." />
    <meta name="twitter:image" content="https://grecua.com/og-image.svg" />
    <!-- Prevent flash of wrong theme before first paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.44.0/dist/tabler-icons.min.css" />
  </head>
  <body class="bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100 font-sans transition-colors">
    <!-- Scroll progress bar -->
    <div id="scroll-bar" class="fixed top-0 left-0 h-[2px] bg-amber-600 dark:bg-amber-500 z-[60] pointer-events-none transition-none" style="width: 0%"></div>
    <Nav />

    <!-- Hero -->
    <section class="max-w-[860px] mx-auto px-6 md:px-8 pt-20 pb-24">
      <p class="fade-up font-mono text-[10px] tracking-[0.18em] uppercase text-amber-700 dark:text-amber-500 mb-6" style="animation-delay: 0ms">CS student &amp; EPM analyst</p>
      <h1 class="fade-up font-display text-[52px] md:text-[72px] font-normal leading-[1.08] text-stone-900 dark:text-stone-100 mb-7 max-w-[680px]" style="animation-delay: 90ms">
        Crafting <span class="italic">thoughtful</span> software for the modern enterprise.
      </h1>
      <p class="fade-up text-[17px] text-stone-600 dark:text-stone-400 leading-[1.75] max-w-[480px] mb-9" style="animation-delay: 170ms">
        Computer Science student at Queen's University. Currently on a 16-month co-op at Metrolinx as an EPM Solution Analyst — financial systems implementation, internal tooling, and SQL.
      </p>
      <a href="#projects" class="fade-up inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.08em] uppercase text-stone-900 dark:text-stone-100 border-b border-stone-900 dark:border-stone-100 pb-0.5 hover:text-amber-700 hover:border-amber-700 dark:hover:text-amber-500 dark:hover:border-amber-500 transition-colors" style="animation-delay: 250ms">
        View my work <i class="ti ti-arrow-right text-[10px]"></i>
      </a>
    </section>

    <!-- About -->
    <section id="about" class="border-t border-stone-200 dark:border-stone-800">
      <div class="reveal max-w-[860px] mx-auto px-6 md:px-8 py-16 pb-20 border-b border-stone-200 dark:border-stone-800">
        <p class="section-label">About</p>
        <div class="grid md:grid-cols-2 gap-16">
          <div>
            <h2 class="font-display text-[34px] font-normal leading-[1.2] text-stone-900 dark:text-stone-100">
              Building things that work <span class="italic">quietly</span> and well.
            </h2>
          </div>
          <div>
            <p class="text-[17px] text-stone-600 dark:text-stone-400 leading-[1.75] mb-5">
              I'm studying Computer Science at Queen's University in Kingston, Ontario. My coursework covers algorithms and data structures, systems programming, databases, and software engineering. I'm drawn to how systems hold up at scale — technically and organizationally.
            </p>
            <p class="text-[17px] text-stone-600 dark:text-stone-400 leading-[1.75]">
              My co-op at Metrolinx involves implementing OneStream EPM — an enterprise financial platform for consolidation, budgeting, and reporting. Day to day: SQL, internal tooling, and helping finance teams migrate away from manual spreadsheet workflows. Working in enterprise systems has given me a different lens on software, where adoption and correctness matter as much as the code.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience & Education -->
